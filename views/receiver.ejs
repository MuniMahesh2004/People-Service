<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PeopleService-Receiver</title>
    <link rel="stylesheet" href="reg.css">
    <link rel="stylesheet" href="style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body id="body">
    <header>
        <h2 class="Logo">People Service</h2>
        <nav class="navigation" id="nav">
            <a href="/home">Home</a>
            <a href="/donar">Become a donor</a>
            <a href="/receiver">Become a receiver</a>
            <a href="/signout">Log out</a>
        </nav>
        <i class='bx bx-menu' id="menu" onclick="myfun()"></i>
        <i class="fa-solid fa-xmark" id="men" onclick="myfun()"></i>
    </header>

    <div class="filter" id="re">
        <div class="filter-content">
            <h3 style="color: rgb(239, 233, 234);">Filter by State, City, and Blood Group</h3>
        
        <!-- Form for filtering donors -->
        <form id="filterForm" onsubmit="filterDonors(event)">
            <!-- State Dropdown -->
            <select name="state" id="state" onchange="updateCities()" required>
                <option value="">--Select State--</option>
                <option value="AP">Andhra Pradesh</option>
                <option value="TS">Telangana</option>
            </select>

            <!-- City Dropdown -->
            <select name="city" id="city" required>
                <option value="">--Select City--</option>
            </select>

            <!-- Blood Group Dropdown -->
            <select name="bloodgroup" id="bloodgroup" required>
                <option value="">--Select Blood Group--</option>
                <option value="A+">A+</option>
                <option value="A-">A-</option>
                <option value="B+">B+</option>
                <option value="B-">B-</option>
                <option value="O+">O+</option>
                <option value="O-">O-</option>
                <option value="AB+">AB+</option>
                <option value="AB-">AB-</option>
            </select>

            <button type="submit">Search</button>
        </form>

        <h3 style="color: rgb(239, 233, 234);">Available Donors:</h3>
        <div class="tab">
            <!-- Donors Table -->
            <table border="1" cellpadding="14" cellspacing="0">
                <thead>
                    <tr>
                        <th style="width: 500px;">Name</th>
                        <th style="width: 500px;">Email</th>
                        <th style="width: 550px;">Blood Group</th>
                        <th style="width: 550px;">Phone-No</th>
                        <th style="width: 500px;">State</th>
                        <th style="width: 500px;">City</th>
                    </tr>
                </thead>
                <tbody id="donorTable">
                    <tr>
                        <td colspan="6">No donors found</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="error-message" style="color: red; display: none;">An error occurred while fetching donors. Please try again.</div>
        </div>
        </div>

    <script>
        // Prevent form submission from reloading the page
        function myfun(){
            document.getElementById("menu").classList.toggle("menu");
            document.getElementById("men").classList.toggle("men");
            document.getElementById("nav").classList.toggle("show");
            document.getElementById("body").classList.toggle("body");
            document.getElementById("re").classList.toggle("re");
        }
        function filterDonors(event) {
            event.preventDefault(); // Prevent default form submission

            // Get the selected values
            const state = document.getElementById('state').value;
            const city = document.getElementById('city').value;
            const bloodgroup = document.getElementById('bloodgroup').value;

            // Send the request to the server using Fetch API
            fetch('/receiver', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    state: state,
                    city: city,
                    bloodgroup: bloodgroup
                })
            })
            .then(response => response.json())
            .then(data => {
                // Hide error message
                document.getElementById('error-message').style.display = 'none';

                // Populate the donors table
                const donorTable = document.getElementById('donorTable');
                donorTable.innerHTML = ''; // Clear current rows

                if (data.donors.length > 0) {
                    data.donors.forEach(donor => {
                        const row = `<tr>
                            <td>${donor.name}</td>
                            <td>${donor.email}</td>
                            <td>${donor.bloodgroup}</td>
                            <td>${donor.phone}</td>
                            <td>${donor.state}</td>
                            <td>${donor.city}</td>
                        </tr>`;
                        donorTable.innerHTML += row;
                    });
                } else {
                    donorTable.innerHTML = '<tr><td colspan="6">No donors found</td></tr>';
                }

                // Preserve the selected options in dropdowns after fetch
                document.getElementById('state').value = state;
                document.getElementById('city').value = city;
                document.getElementById('bloodgroup').value = bloodgroup;
            })
            .catch(error => {
                console.error('Error fetching donors:', error);
                document.getElementById('error-message').style.display = 'block';
            });
        }

        // Function to update cities based on the selected state
        function updateCities() {
            var state = document.getElementById("state").value;
            var cities = document.getElementById("city");
            cities.innerHTML = ''; // Clear existing city options

            var cityOptions = {
                'AP': ['Visakhapatnam', 'Vijayawada', 'Guntur', 'Nellore', 'Kurnool', 'Tirupati', 'Rajahmundry', 'Kakinada', 'Eluru', 'Ongole', 'Anantapur', 'Kadapa', 'Srikakulam', 'Vizianagaram', 'Chittoor'],
                'TS': ['Hyderabad', 'Warangal', 'Nizamabad', 'Karimnagar', 'Khammam', 'Mahbubnagar', 'Ramagundam', 'Nalgonda', 'Adilabad', 'Suryapet', 'Miryalaguda', 'Jagtial', 'Mancherial', 'Siddipet', 'Zaheerabad']
            };

            if (state in cityOptions) {
                cityOptions[state].forEach(function(city) {
                    var option = document.createElement('option');
                    option.text = city;
                    option.value = city;
                    cities.add(option);
                });
            }
        }
    </script>
</body>
</html>
