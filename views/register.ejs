<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PeopleService-SignUp</title>
    <link rel="stylesheet" href="style.css">
     <link rel="stylesheet" href="reg.css">
     <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
     <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
</head>
<body id="body">
    <header>
        <h2 class="Logo">People Service</h2>
        <nav class="navigation" id="nav">
             <a href="index.html">Home</a>
             <a href="/register" id="myLink" >Sign-Up</a>
             <a href="/sign">Sign-In</a>
             <a href="https://www.who.int/campaigns/world-blood-donor-day/2018/who-can-give-blood">eligibility?</a>
             <a href="contact.html">contact</a>
         </nav>
         <i class='bx bx-menu' id="menu" onclick="myfun()"></i>
        <i class="fa-solid fa-xmark" id="men" onclick="myfun()"></i>
     </header>
         <!-- <i class='bx bx-window-close' id="close" style="color: white; font-size:25px;" ></i> -->   
    <div class="reg" id="reg" >
        <h3 style="color: white; text-align:center">Join With us </h3>
        <form onsubmit="handleRegister(event)" >
            <i class='bx bx-user' class="image" style="color: aliceblue;"></i>
            <input type="text" id="username" name="username" placeholder="Enter Username" required><br><br>
            <i class='bx bx-envelope'class="image" style="color: aliceblue;"></i>
            <input type="email" id="email" name="email" placeholder="Enter Email" required><br><br>
            <i class='bx bx-lock-open-alt'class="image" style="color: aliceblue;"></i>
            <input type="password" id="password" name="password" placeholder="Enter Password" required><br><br>
            <i class='bx bx-lock-alt' class="image"style="color: aliceblue;"></i>
            <input type="password" id="confirmpassword" name="confirmpassword" placeholder="Enter Confirm Password" required><br><br>
            <button >Register</button>
            <br>
       </form>
       <p id="pass" style="font-size: 14px; margin-top:15px;"></p>
 </div>
</body>
<script>
    function myfun(){
        document.getElementById("menu").classList.toggle("menu");
        document.getElementById("men").classList.toggle("men");
        document.getElementById("nav").classList.toggle("show");
        document.getElementById("body").classList.toggle("body");
        document.getElementById("reg").classList.toggle("re");
    }
    // Client-side validation and fetch POST request
    async function handleRegister(event) {
        event.preventDefault(); // Prevent form from submitting the default way
    
        // Grab the form data
        const username = document.getElementById('username').value;
        const email = document.getElementById('email').value;
        const password = document.getElementById('password').value;
        const confirmpassword = document.getElementById('confirmpassword').value;
    
        // Clear previous messages
        document.getElementById('pass').innerHTML = '';
    
        // Validate passwords match and length
        if (password.length < 8) {
            document.getElementById('pass').innerHTML = 'Password must be at least 8 characters';
            return;
        }
        if (password !== confirmpassword) {
            document.getElementById('pass').innerHTML = 'Confirm password must match password';
            return;
        }
    
        // If validation passes, make the POST request to your Node.js backend
        try {
            const response = await fetch('/register', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ username, email, password, confirmpassword })
            });
    
            // Parse the JSON response from the server
            const result = await response.json();
    
            // Check if the registration was successful
            if (response.ok) {
                alert('Registration successful!');
                window.location.href = '/home'; // Redirect to home after successful registration
            } 
            // Handle specific case if user already exists
            else if (result.message === 'User already exists!') {
                document.getElementById('pass').innerHTML = 'User already exists!';
            } 
            // Handle any other errors
            else {
                alert(result.error || 'Registration failed.');
            }
        } catch (error) {
            console.error('Error during registration:', error);
            alert('An error occurred. Please try again.');
        }
    }
    </script>
</html>